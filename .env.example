# ── Security Intelligence & Remediation Agent (v1) ──────────────────────────────

# Required: Anthropic API key (Risk Assessor uses Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model for the Risk Assessor (default claude-sonnet-4-6)
# RISK_MODEL=claude-sonnet-4-6

# ── Actions (direct API calls — v1) ─────────────────────────────────────────────
# Slack incoming webhook (urgent decisions fire an alert here)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# GitHub: a token with `repo` (or fine-grained issues:write) scope + the target repo
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-org/agent-demo
# ISSUE_LABELS=security,vulnerability

# Dry-run is OFF by default — the agent posts for real. Set DRY_RUN=true to simulate
# (fetch + triage + log, but no Slack/GitHub posts).
# DRY_RUN=true

# ── Feeds (all public; keys optional) ───────────────────────────────────────────
# NVD raises rate limits with a free API key: https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=
# NVD_DAYS=1            # look back window for NVD CVEs
# NVD_LIMIT=50         # max CVEs pulled from NVD per scan
# GH_ADVISORY_COUNT=30 # GitHub global advisories pulled per scan
# MAX_ENRICH=12        # max CVEs enriched with HackerNews + Reddit search

# ── Scheduling / runtime ────────────────────────────────────────────────────────
# PORT=3000
# SCAN_INTERVAL_MINUTES=360 # built-in scheduler; default 360 = every 6 hours (0 disables)
# SCAN_ON_START=true        # default true — run one scan immediately on startup
# STATE_FILE=./.security-agent-state.json   # dedup store
